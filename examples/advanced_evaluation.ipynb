    "for region in regions:\n",
    "    emb_shape = embeddings_dict[region].shape\n",
    "    n_categories = len(set(categories_dict[region]))\n",
    "    print(f\"   {region}: {emb_shape[0]} samples, {emb_shape[1]}D, {n_categories} categories\")"
   ]
